{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    ":dependencyDashboard",
    ":enableRenovate",
    ":renovatePrefix",
    ":semanticCommits",
    ":separateMajorReleases",
    ":separateMultipleMajorReleases",
    ":timezone(America/Chicago)",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    "replacements:k8s-registry-move",
  ],
  dependencyDashboard: {
    title: "🤖 Renovate Dashboard",
  },
  // config/ holds SOPS-encrypted secrets and host-level OS config; only
  // config/cluster.yaml (k0sctl) is scanned, by the k0s custom manager below.
  ignorePaths: [
    "config/secrets.yaml",
    "config/*.secret.yaml",
    "config/ubuntu/**",
  ],
  rebaseWhen: "conflicted",
  // config:recommended caps new PRs at 2/hour, which leaves most updates
  // stuck in "Rate-Limited" on the dashboard. Keep an overall cap instead.
  prHourlyLimit: 0,
  prConcurrentLimit: 20,

  flux: {
    managerFilePatterns: ["/(bootstrap|core|platform|services)/.+\\.yaml$/"],
  },
  "helm-values": {
    managerFilePatterns: ["/(bootstrap|core|platform|services)/.+\\.yaml$/"],
  },
  kubernetes: {
    managerFilePatterns: ["/(bootstrap|core|platform|services)/.+\\.yaml$/"],
  },

  customDatasources: {
    "grafana-dashboards": {
      defaultRegistryUrlTemplate: "https://grafana.com/api/dashboards/{{packageName}}",
      format: "json",
      transformTemplates: ['{"releases":[{"version": $string(revision)}]}'],
    },
  },

  customManagers: [
    {
      customType: "regex",
      description: "Process GitHub download dependencies in YAML files",
      managerFilePatterns: ["/\\.yaml$/"],
      matchStrings: [
        // https://github.com/rancher/system-upgrade-controller/releases/download/v0.13.2/crd.yaml
        "https:\\/\\/github.com\\/(?<depName>\\S+?\\/\\S+?)\\/releases\\/download\\/(?<currentValue>(v|\\d)\\S+?)\\/\\S+",
        // https://raw.githubusercontent.com/external-secrets/external-secrets/v0.9.11/docs/snippets/dashboard.json
        "https:\\/\\/raw.githubusercontent.com\\/(?<depName>\\S+?\\/\\S+?)\\/(?<currentValue>(v|\\d)\\S+?)\\/\\S+",
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
      // extractVersionTemplate: "{{#if extractVersion}}{{{extractVersion}}}{{else}}^v?(?<version>.*)${{/if}}",
    },
    {
      // # renovate: datasource=<ds> depName=<name> [versioning=<v>] [extractVersion=<re>]
      // ARG SOME_VERSION=<version>
      customType: "regex",
      description: "Process tool versions pinned in image Dockerfiles",
      managerFilePatterns: ["/(^|/)images/.+/Dockerfile$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?( extractVersion=(?<extractVersion>\\S+))?\\s+ARG \\S+?=(?<currentValue>\\S+)",
      ],
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
      extractVersionTemplate: "{{#if extractVersion}}{{{extractVersion}}}{{else}}^v?(?<version>.*)${{/if}}",
    },
    {
      customType: "regex",
      description: "Process k0s version in the k0sctl cluster config",
      managerFilePatterns: ["/^config/cluster\\.yaml$/"],
      matchStrings: [
        "k0s:\\s*\\n\\s*version:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+\\+k0s\\.\\d+)",
      ],
      depNameTemplate: "k0sproject/k0s",
      datasourceTemplate: "github-releases",
      versioningTemplate: "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\+k0s\\.(?<build>\\d+)$",
    },
    {
      customType: "regex",
      description: "Process CloudNativePG cluster images (spec.imageName)",
      managerFilePatterns: ["/(core|platform|services)/.+\\.yaml$/"],
      matchStrings: [
        "imageName:\\s*(?<depName>[^\\s:@]+):(?<currentValue>[^\\s@]+)(@(?<currentDigest>sha256:[a-f0-9]+))?",
      ],
      datasourceTemplate: "docker",
      autoReplaceStringTemplate: "imageName: {{depName}}:{{newValue}}{{#if newDigest}}@{{newDigest}}{{/if}}",
    },
    {
      customType: "regex",
      description: "Process Grafana dashboards pulled from grafana.com",
      managerFilePatterns: ["/(core|platform|services)/.+\\.yaml$/"],
      matchStrings: [
        "https:\\/\\/grafana\\.com\\/api\\/dashboards\\/(?<packageName>\\d+)\\/revisions\\/(?<currentValue>\\d+)\\/download",
      ],
      depNameTemplate: "grafana-dashboard-{{{packageName}}}",
      datasourceTemplate: "custom.grafana-dashboards",
      versioningTemplate: "regex:^(?<major>\\d+)$",
    },
  ],

  packageRules: [
    {
      description: ["Disable digest pinning for OCIRepository resources"],
      matchManagers: ["flux"],
      matchDatasources: ["docker"],
      pinDigests: false,
    },
    {
      // OCI helm charts are served from docker-style registries, so the flux
      // manager reports them as "docker tag" updates. Filter on package name
      // (every OCI helm chart in this repo has "chart" or "-helm" in the path)
      // and rewrite the commit subject to read as a chart update.
      description: ["Relabel OCI helm chart commits as chart updates"],
      matchManagers: ["flux"],
      matchDatasources: ["docker"],
      matchPackageNames: ["*chart*", "*-helm*"],
      commitMessageTopic: "helm chart {{depName}}",
      commitMessageExtra: "",
    },
    {
      // gotk-components.yaml is generated by `flux install`. The flux manager
      // regenerates the whole file (controller images included) when
      // fluxcd/flux2 is bumped; per-image PRs from these managers only
      // duplicate and conflict with that.
      description: ["Let the flux manager own gotk-components.yaml"],
      matchFileNames: ["bootstrap/flux-system/gotk-components.yaml"],
      matchManagers: ["kubernetes", "helm-values"],
      enabled: false,
    },
    {
      description: ["Auto-merge updates to github-action packages"],
      matchManagers: ["github-actions"],
      automerge: true,
      automergeType: "branch",
      matchUpdateTypes: ["minor", "patch", "digest"],
      ignoreTests: true,
    },
    {
      description: ["Loose versioning for non-semver packages"],
      matchDatasources: ["docker"],
      matchPackageNames: ["/plex/"],
      versioning: "loose",
    },
    {
      description: ["Custom schedule for frequently updated packages"],
      matchDatasources: ["docker", "helm"],
      matchPackageNames: ["/postgresql/", "/reloader/"],
      schedule: ["on the first day of the month"],
    },
    {
      // A Postgres major bump is a data migration (and the cluster is named
      // postgresql-18); do it deliberately, not from a Renovate PR.
      description: ["Do not propose Postgres major upgrades"],
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/cloudnative-pg/postgresql"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
    {
      description: ["Update Immich Images in the same PR"],
      matchDatasources: ["docker"],
      matchPackageNames: ["/immich/"],
      groupName: "Immich",
    },
    {
      description: ["Update Dragonfly operator CRDs and image together"],
      matchPackageNames: ["dragonflydb/dragonfly-operator", "ghcr.io/dragonflydb/operator"],
      groupName: "dragonfly-operator",
    },
    {
      description: ["Update Intel device plugins operator and GPU plugin together"],
      matchPackageNames: ["/intel-device-plugins-operator/", "intel/intel-gpu-plugin"],
      groupName: "intel-device-plugins",
    },
    {
      description: ["Group Grafana dashboard revisions into one PR"],
      matchDatasources: ["custom.grafana-dashboards"],
      groupName: "grafana-dashboards",
      commitMessageTopic: "grafana dashboards",
      separateMajorMinor: false,
    },
    {
      description: ["Velero AWS plugin minors track Velero minors"],
      matchPackageNames: ["velero/velero-plugin-for-aws"],
      matchUpdateTypes: ["major", "minor"],
      prBodyNotes: [
        "⚠️ velero-plugin-for-aws v1.N only supports Velero v1.(N+4) (e.g. plugin v1.14 ↔ Velero v1.18). Check the Velero chart's appVersion before merging.",
      ],
    },
    {
      // pinning these breaks stuff.
      // - flux-system: i don't quite know, but it just breaks renovate?
      // - resource/hardware#intel-gpu-plugin: operator does not support digesting
      // - development/forgejo: pinning the oci helm repository does not work
      description: ["Do not attempt to pinDigest files that cause issues"],
      pinDigests: false,
      matchFileNames: [
        "bootstrap/flux-system/**",
        "core/resources/hardware.yaml",
        "services/development/forgejo.yaml",
      ],
    },
  ],
}
